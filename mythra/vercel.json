{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...all].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...all]" },
    { "source": "/(health|ready)", "destination": "/api/[...all]" },
    { "source": "/((?!api/|health|ready).*)", "destination": "/index.html" }
  ]
}
