# Copy to .env to light up multiplayer (never commit .env with real secrets)
# Backend base URL — the web client talks to the MYTHIO API here.
VITE_API_URL=http://localhost:4000

# Backend port (server reads PORT; default 4000)
PORT=4000

# --- Database (optional) ---
# Unset = local SQLite file (server/.data/mythra.db). Set = Postgres
# (Neon free tier) — used automatically, e.g. on Vercel:
#DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- AI directors (optional site keys) ---
# The host can set a key per platform here; explorers can still paste their
# OWN key on the Planner page (per login × online/offline, this browser only),
# which always overrides the site key. Empty = explorers bring their own key.
#VITE_OPENAI_API_KEY=
#VITE_ANTHROPIC_API_KEY=
#VITE_GEMINI_API_KEY=
#VITE_OPENROUTER_API_KEY=
#VITE_GROQ_API_KEY=
#VITE_MISTRAL_API_KEY=
#VITE_NIM_API_KEY=
#VITE_CUSTOM_API_KEY=
# Spare keys per platform (_2 … _5): when one hits limits or fails, the next
# spare takes over automatically. Example:
#VITE_GROQ_API_KEY_2=
#VITE_GROQ_API_KEY_3=
# Optional endpoint overrides (Ollama host, custom gateway, …)
#VITE_OLLAMA_BASE_URL=http://localhost:11434/v1
#VITE_CUSTOM_BASE_URL=
#VITE_OPENAI_BASE_URL=
#VITE_OPENROUTER_BASE_URL=
#VITE_GROQ_BASE_URL=
#VITE_MISTRAL_BASE_URL=
#VITE_NIM_BASE_URL=
# Optional default director when an explorer never picked one (default: mock)
#VITE_AI_DEFAULT_PROVIDER=mock
#VITE_AI_DEFAULT_MODEL=
# --- Sign in with Discord (optional) ---
# Discord Developer Portal → your application → OAuth2:
#   redirect:  http://localhost:4000/api/auth/discord/callback
#   scope needed: identify
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
# Public game URL players return to (default http://localhost:5173)
#FRONTEND_URL=http://localhost:5173
# API's own public base (default http://localhost:4000) — used for the callback URL
#API_BASE=http://localhost:4000
# --- Admin panel (optional) ---
# Allowlisted admin emails + shared admin key. Both must be set or every
# /api/admin/* call fails closed. The Admin page (/admin) logs in with these.
#ADMIN_EMAILS=you@example.com
#ADMIN_KEY=change-me-to-something-long
