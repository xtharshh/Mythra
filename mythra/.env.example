# Copy to .env to light up multiplayer (never commit .env with real secrets)
# Backend base URL — the web client talks to the MYTHRA API here.
VITE_API_URL=http://localhost:4000

# Backend port (server reads PORT; default 4000)
PORT=4000

# --- Sign in with Discord (optional) ---
# Discord Developer Portal → your application → OAuth2:
#   redirect:  http://localhost:4000/api/auth/discord/callback
#   scope needed: identify
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
# Public game URL players return to (default http://localhost:5173)
#FRONTEND_URL=http://localhost:5173
# API's own public base (default http://localhost:4000) — used for the callback URL
#API_BASE=http://localhost:4000
